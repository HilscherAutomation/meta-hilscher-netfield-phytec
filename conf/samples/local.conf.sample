# Version of local configuration file
CONF_VERSION = "2"

# Supported machines
#MACHINE ?= "phyboard-pollux-imx8mp-3"

ACCEPT_FSL_EULA = "1"

# Supported distros
DISTRO ?= "netiot"

# Parallelism Options
BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()*1}"
PARALLEL_MAKE ?= "-j ${@oe.utils.cpu_count()*1}"

# Disk Space Monitoring during the build
BB_DISKMON_DIRS = "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
"

# Build should fail if a patch cannot apply
PATCHRESOLVE = "noop"

# ICECC support
INHERIT_DISTRO:append = " icecc"
# Disable icecc builds.
ICECC_DISABLED ?= "1"
# Disable fallthrough warning/error to prevents icecc build errors when using gcc 7.x.
#TARGET_CFLAGS:append = " -Wimplicit-fallthrough=0"

# FIXME: Temporarily defined here as currently we are using phytec MACHINE
# definition. This shall be moved to a phytec-derived Hilscher machine
# definition.
HILSCHER_RESCUE_IMAGE ??= "hilscher-rescue-image"

# meta-imx uses never version than that present in meta-freescale. In phytec
# bsp they are patching meta-freescale/EULA with newer version to make the md5
# checksum compatible. Instead, FSL_EULA_FILE can be overridden.
FSL_EULA_FILE = "${TOPDIR}/../meta-imx/EULA.txt"

# FIXME: Temporarily set MACHINE to the original phytec definition. This shall
# be replaced by phytec-derived Hilscher machine definition. This is tricky
# because local.overrides.conf contains `MACHINE ?= ...` which will be
# confusing.
MACHINE = "phyboard-pollux-imx8mp-3"

include local.overrides.conf
